{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llmic",
  "compatibility_date": "2026-08-08",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "llmic.szlk.uk",
      "custom_domain": true
    }
  ]
}
